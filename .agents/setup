#!/usr/bin/env bash
set -euo pipefail

# Zola version pinned to the newest release. tabi v5.0.0 (and its Tera 2
# component syntax) requires Zola 0.23.6 or newer.
ZOLA_VERSION="${ZOLA_VERSION:-0.23.6}"

step() { printf '[setup] %s %s\n' "$(date +%H:%M:%S)" "$*"; }

install_zola() {
  local installed
  installed="$(zola --version 2>/dev/null | awk '{print $2}' || true)"
  if [ "$installed" = "$ZOLA_VERSION" ]; then
    step "zola ${ZOLA_VERSION} already installed at $(command -v zola)"
    return
  fi
  step "installing zola ${ZOLA_VERSION} (found: ${installed:-none})"
  local arch libc url tmp
  case "$(uname -m)" in
    x86_64) arch=x86_64; libc=musl ;;
    aarch64 | arm64) arch=aarch64; libc=gnu ;;
    *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
  esac
  url="https://github.com/getzola/zola/releases/download/v${ZOLA_VERSION}/zola-v${ZOLA_VERSION}-${arch}-unknown-linux-${libc}.tar.gz"
  tmp="$(mktemp -d)"
  curl -fsSL -o "$tmp/zola.tar.gz" "$url"
  tar -xz -f "$tmp/zola.tar.gz" -C "$tmp" zola
  install -m 0755 "$tmp/zola" /usr/local/bin/zola
  rm -rf "$tmp"
  step "installed $(zola --version) at $(command -v zola)"
}

# Orb notes for agents working in future orbs.
notes_marker="# spiss.dev orb notes"
notes_file="$HOME/.config/amp/AGENTS.md"
if grep -Fqx "$notes_marker" "$notes_file" 2>/dev/null; then
  step "agent notes already present"
else
  step "writing orb notes to ~/.config/amp/AGENTS.md"
  mkdir -p "$(dirname "$notes_file")"
  cat >> "$notes_file" <<EOF

$notes_marker
- Zola ${ZOLA_VERSION} is installed at /usr/local/bin/zola. The theme (tabi v5.0.0) requires Zola 0.23.6+; shortcodes are Tera components under templates/components/.
- \`zola build\` finishes in about a second; the dev server is declared as the \`site\` service in .amp/services.yaml (\`amp orb services ensure\`).
EOF
fi

time install_zola
step "done"
